{
  "name": "@app/frontend-kiosk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../scripts/check-env.mjs",
    "build": "vite build",
    "build:emulator": "vite build --mode emulator",
    "build:test": "vite build --mode test",
    "build:final": "vite build --mode final",
    "predev": "node ../scripts/check-env.mjs emulator",
    "dev": "vite --mode emulator --host --port 1347",
    "pretypecheck": "pnpm --filter @app/types build",
    "preview": "vite preview --host --port 1347",
    "start": "vite preview --host --port 1347",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@app/frontend-core": "workspace:*",
    "@app/types": "workspace:*",
    "firebase": "^11.0.2",
    "handlebars": "^4.7.9",
    "sass": "^1.90.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "qr-code-styling": "^1.9.2"
  }
}