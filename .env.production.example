# Solo per il comando backend:deploy. Copiare in .env.production (ignorato da Git).
# Non caricare questo file nell'hosting frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# I segreti Strava si configurano separatamente: supabase/functions/.env.example.
